+    set: { robe: '#6a4a8a', inner: '#f4e8f4', trim: '#d8b050', belt: '#3a2450', pants: '#4a3462', boots: '#2a1a3a', robeLen: 'long', sleeve: 'wide', shawl: '#c8a8e0', sash: '#d8b050', ribbon: '#d8b050' } },
+  { id: 'hongzhuang', name: '红妆劲服', sex: 'f', desc: '朱红窄袖，英气飒爽的女剑修。',
+    set: { robe: '#b8323a', inner: '#f6e4d8', trim: '#2a1a1a', belt: '#2a1a1a', pants: '#3a2224', boots: '#1e1214', robeLen: 'short', sleeve: 'narrow', shawl: undefined, sash: '#2a1a1a', ribbon: '#2a1a1a' } },
+];
+export const OUTFIT_BY_ID = new Map(OUTFITS.map((o) => [o.id, o]));
+
+export function outfitsFor(sex: 'm' | 'f') { return OUTFITS.filter((o) => o.sex === 'u' || o.sex === sex); }
+
+/** 换上某套衣装（返回新 Look，不改原对象） */
+export function wear(look: Look, id: string): Look {
+  const o = OUTFIT_BY_ID.get(id); if (!o) return look;
+  const out: Look = { ...look, outfit: id };
+  for (const [k, val] of Object.entries(o.set)) (out as any)[k] = val;
+  if (look.sex === 'm') out.shawl = undefined;
+  return out;
+}
