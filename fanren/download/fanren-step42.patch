+    fingerTube([thumbBase, t1, t2], 0.5 * S * k, 0.42 * S * k);
+    tendons();
+    if (f > 0.6 && S > 1.6) { // 指尖凝聚一点灵光
+      const tip = at(palmLen + 3.4 * fl, 0.2);
+      const gr = g.createRadialGradient(tip.x, tip.y, 0, tip.x, tip.y, 2.4 * S);
+      gr.addColorStop(0, `rgba(200,255,235,${0.55 * (f - 0.6) * 2.5})`); gr.addColorStop(1, 'rgba(200,255,235,0)');
+      g.fillStyle = gr; g.beginPath(); g.arc(tip.x, tip.y, 2.4 * S, 0, Math.PI * 2); g.fill();
+    }
+  } else if (pose === 'palm') {
+    // 推掌：五指张开，用力越大张得越开、指尖反翘
+    palm();
+    const spread = 0.12 + 0.22 * f, back2 = -0.02 - 0.1 * f;
+    for (let i = 0; i < 4; i++) {
+      const w = knW * (0.78 - i * 0.52);
+      const L = [[1.15, 0.8, 0.65], [1.3, 0.9, 0.7], [1.2, 0.85, 0.65], [0.95, 0.65, 0.55]][i];
+      finger(at(palmLen + 0.1, w), dirA + (1.5 - i) * spread * thumbSide, L, back2, fr * (i === 3 ? 0.85 : 1));
+    }
+    finger(at(0.9, wristW + 0.2), dirA + (0.75 + 0.35 * f) * thumbSide, [1.1, 0.95], -0.05, 0.5);
+    tendons();
+  } else if (pose === 'mudra') {
+    // 结印：拇指与食指相扣成环，余指舒展
+    palm();
+    for (let i = 1; i < 4; i++) {
+      const w = knW * (0.78 - i * 0.52);
+      finger(at(palmLen + 0.1, w), dirA, [1.1, 0.8, 0.6], 0.18, fr);
+    }
+    const i0 = at(palmLen + 0.1, knW * 0.78);
+    finger(i0, dirA, [1.0, 0.7, 0.6], 0.75, fr);
+    const ring = at(palmLen + 0.8, knW + 0.5);
+    fingerTube([thumbBase, at(1.8, wristW + 0.8), ring], 0.5 * S * k, 0.42 * S * k);
+  } else {
+    // 自然：手指微屈，层次分明
+    palm();
+    for (let i = 0; i < 4; i++) {
+      const w = knW * (0.78 - i * 0.52);
+      const L = [[1.05, 0.75, 0.6], [1.2, 0.85, 0.65], [1.1, 0.8, 0.6], [0.85, 0.6, 0.5]][i];
+      finger(at(palmLen + 0.1, w), dirA, L, 0.28 + i * 0.05 + f * 0.2, fr * (i === 3 ? 0.85 : 1));
+    }
+    finger(at(0.8, wristW + 0.15), dirA + 0.55 * thumbSide, [1.0, 0.85], 0.2, 0.5);
+  }
+  // 腕部收口线（袖口压住）
+  if (S > 1.4) {
+    g.strokeStyle = rgba(shade(skin, -0.4), 0.35); g.lineWidth = Math.max(0.3, 0.14 * S);
+    const a = at(0.15, wristW * 0.9), b = at(0.15, -wristW * 0.9);
+    g.beginPath(); g.moveTo(a.x, a.y); g.quadraticCurveTo(at(0.4, 0).x, at(0.4, 0).y, b.x, b.y); g.stroke();
+  }
+}
