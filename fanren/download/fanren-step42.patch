+import { shade, rgba } from '../core/canvas';
+
+/** 脸部参数（均为倍率/偏移，1 或 0 为基准） */
+export interface FaceParams {
+  jaw: number;      // 下颌宽 0.85–1.12
+  chin: number;     // 下巴长 0.85–1.15
+  eye: number;      // 眼睛大小 0.8–1.25
+  eyeTilt: number;  // 眼尾上挑 -0.4–0.6
+  brow: number;     // 眉浓 0.6–1.5
+  browTilt: number; // 眉峰（剑眉 >0，柳叶眉 <0）-0.5–0.6
+  nose: number;     // 鼻长 0.85–1.15
+  mouth: number;    // 嘴宽 0.8–1.2
+}
+/** 身材参数 */
+export interface BodyParams {
+  shoulder: number; // 肩宽
+  chest: number;    // 胸厚（男：胸肌 / 女：胸型）
+  waist: number;    // 腰围
+  hip: number;      // 臀宽
+  limb: number;     // 四肢粗细
+  leg: number;      // 腿长
+  neck: number;     // 脖长
+}
+
+export const FACE_BASE: Record<'m' | 'f', FaceParams> = {
+  m: { jaw: 1, chin: 1, eye: 1, eyeTilt: 0.1, brow: 1.1, browTilt: 0.25, nose: 1, mouth: 1 },
+  f: { jaw: 0.92, chin: 0.95, eye: 1.08, eyeTilt: 0.15, brow: 0.8, browTilt: -0.15, nose: 0.94, mouth: 0.9 },
+};
+export const BODY_BASE: Record<'m' | 'f', BodyParams> = {
+  m: { shoulder: 1, chest: 1, waist: 1, hip: 1, limb: 1, leg: 1, neck: 1 },
+  f: { shoulder: 1, chest: 1, waist: 1, hip: 1, limb: 0.86, leg: 1.03, neck: 1.08 },
+};
+
+export const FACE_RANGE: Record<keyof FaceParams, [number, number, string]> = {
+  jaw: [0.85, 1.12, '下颌'], chin: [0.85, 1.15, '下巴'], eye: [0.8, 1.25, '眼睛'], eyeTilt: [-0.4, 0.6, '眼尾'],
+  brow: [0.6, 1.5, '眉浓'], browTilt: [-0.5, 0.6, '眉峰'], nose: [0.85, 1.15, '鼻长'], mouth: [0.8, 1.2, '嘴宽'],
+};
+export const BODY_RANGE: Record<keyof BodyParams, [number, number, string]> = {
+  shoulder: [0.85, 1.18, '肩宽'], chest: [0.85, 1.25, '胸'], waist: [0.8, 1.25, '腰'], hip: [0.85, 1.2, '臀'],
+  limb: [0.8, 1.2, '四肢'], leg: [0.92, 1.1, '腿长'], neck: [0.85, 1.2, '脖长'],
+};
+
+export function faceOf(look: { sex: 'm' | 'f'; face?: Partial<FaceParams> }): FaceParams {
+  return { ...FACE_BASE[look.sex], ...(look.face || {}) };
+}
+export function bodyOf(look: { sex: 'm' | 'f'; body?: Partial<BodyParams> }): BodyParams {
+  return { ...BODY_BASE[look.sex], ...(look.body || {}) };
+}
+
+// ---------------------------------------------------------------- 手
+export type HandPose = 'relax' | 'fist' | 'sword' | 'palm' | 'grip' | 'mudra';
+export interface HandSpec { pose: HandPose; force: number }
+
+/** 动作 → 手势与发力 */
+export function handFor(action: string, side: 1 | -1, at: number, t: number, hold: string | undefined, hero: boolean): HandSpec {
+  const right = side < 0;
+  if (hold && hold !== 'none' && right && action !== 'cast' && action !== 'fly') return { pose: 'grip', force: 0.45 };
+  switch (action) {
+    case 'run': return { pose: 'fist', force: hero ? 0.75 : 0.5 };
+    case 'walk': return { pose: 'relax', force: 0.1 };
+    case 'fly': return right ? { pose: 'sword', force: 0.85 } : { pose: 'fist', force: 0.3 };
+    case 'sit': return { pose: 'mudra', force: 0.2 };
+    case 'cast': {
+      const k = Math.min(1, at / 0.22);
+      return right ? { pose: 'palm', force: k * (0.85 + 0.15 * Math.sin(at * 9)) } : { pose: 'sword', force: 0.9 * k };
+    }
+    case 'gather': return right ? { pose: 'grip', force: 0.6 + 0.2 * Math.sin(at * 6) } : { pose: 'relax', force: 0.2 };
+    case 'hit': return { pose: 'palm', force: 0.35 };
+    case 'dodge': return { pose: 'palm', force: 0.55 };
+    default: return { pose: 'relax', force: 0.05 + 0.03 * Math.sin(t) };
+  }
+}
+
+type Pt = { x: number; y: number };
