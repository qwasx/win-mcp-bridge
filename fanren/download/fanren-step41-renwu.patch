+export interface HandGeo { fingers: V3[][]; thumb: V3[]; palm: V3[]; center: V3; tip: V3 }
+export function handGeo(h: HandFrame, c: Float32Array, k: number): HandGeo {
+  const { w, a, n, t } = h;
+  const fingers: V3[][] = [];
+  for (let i = 0; i < 4; i++) {
+    let p = vadd(vadd(vadd(w, a, (PALM_L + KL[i]) * k), t, KU[i] * k), n, -0.1 * k);
