+
+function qpt(a: P2, c: P2, b: P2, t: number) {
+  const u = 1 - t;
+  return { x: u * u * a.x + 2 * u * t * c.x + t * t * b.x, y: u * u * a.y + 2 * u * t * c.y + t * t * b.y };
+}
+
+function drawEye(c: FaceCtx, sx: number) {
