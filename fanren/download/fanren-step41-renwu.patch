+// ---------------------------------------------------------------- 几何
+const FL = [[1.5, 0.92, 0.72], [1.66, 1.02, 0.78], [1.56, 0.96, 0.72], [1.22, 0.76, 0.62]];
+const FR = [0.335, 0.35, 0.325, 0.28];
+const KU = [0.96, 0.32, -0.31, -0.9];
+const KL = [0.02, 0.1, 0, -0.3];
+export const PALM_L = 3.1;
