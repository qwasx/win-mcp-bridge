+  );
+}
+
+/** 游戏内：衣橱面板（I 键 / 「衣」按钮） */
+export function WardrobePanel({ game, onClose }: { game: GameLike; onClose: () => void }) {
+  const [w, setW] = useState<Wardrobe>(() => game.hero.wardrobe ?? wardrobeOf(game.player.look));
