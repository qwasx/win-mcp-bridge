+  scholar: ['rushan'],
+  farmer: ['buyi'],
+  merchant: ['jinpao'],
+  female: ['ruqun', 'ruqun', 'guangxiu', 'guangxiu', 'beizi', 'nvxia', 'gongzhuang', 'cungu'],
