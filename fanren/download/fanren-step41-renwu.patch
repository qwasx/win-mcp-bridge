+
+/** 由前臂方向 + 旋后角（掌心朝上/朝前为正）+ 腕屈角（向掌心折为正）得到手的坐标系；side=1 左手，-1 右手 */
+export function armHandFrame(w: V3, f: V3, side: 1 | -1, sup: number, bend: number): HandFrame {
+  const base = side > 0 ? { x: -1, y: -0.18, z: 0.12 } : { x: 1, y: -0.18, z: 0.12 };
