{
  "name": "ming-warband",
  "version": "2.0.0",
  "private": true,
  "description": "铁血大明 —— 明末背景的 2D 类《骑马与砍杀》网页策略游戏",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "build:single": "node scripts/build-single.mjs",
    "build:server": "vite build --config server/vite.server.config.ts",
    "server": "node dist-server/server.mjs",
    "dev:server": "tsx server/main.ts",
    "build:all": "npm run build && npm run build:server"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
